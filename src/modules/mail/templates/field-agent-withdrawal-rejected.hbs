<h1 style="margin:0 0 12px;font-size:22px;font-weight:700;color:#212529;line-height:1.3;">
  Withdrawal rejected
</h1>
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#495057;">
  Hello <strong>{{name}}</strong>,
</p>
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#495057;">
  Your wallet withdrawal request of
  <strong>₹{{amount}}</strong>
  has been <strong style="color:#dc3545;">rejected</strong>.
  The reserved amount has been released back to your available wallet balance.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 20px;background-color:#fff5f5;border:1px solid #f5c2c7;border-radius:10px;">
  <tr>
    <td style="padding:16px 18px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;width:140px;">Request ID</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;">{{requestId}}</td>
        </tr>
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;">Amount</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;">₹{{amount}}</td>
        </tr>
        {{#if adminRemarks}}
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;vertical-align:top;">Reason</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;">{{adminRemarks}}</td>
        </tr>
        {{/if}}
      </table>
    </td>
  </tr>
</table>

{{> button url=loginUrl label="Open wallet" brandPrimary=brandPrimary}}

<p style="margin:0;font-size:13px;line-height:1.5;color:#6c757d;">
  You may submit a new withdrawal request from your wallet if needed.
  For help, contact
  <a href="mailto:{{supportEmail}}" style="color:{{brandPrimary}};">{{supportEmail}}</a>.
</p>
