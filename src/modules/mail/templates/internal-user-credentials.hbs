<h1 style="margin:0 0 12px;font-size:22px;font-weight:700;color:#212529;line-height:1.3;">
  Your internal user account is ready
</h1>
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#495057;">
  Hello <strong>{{name}}</strong>,
</p>
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#495057;">
  An internal user account has been created for you on <strong>{{brandName}}</strong>.
  Use the credentials below to sign in to the platform.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 20px;background-color:#f8f9fa;border:1px solid #e9ecef;border-radius:10px;">
  <tr>
    <td style="padding:16px 18px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;width:120px;">Email (login)</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;">{{email}}</td>
        </tr>
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;">Password</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;font-family:Consolas,Monaco,monospace;">{{password}}</td>
        </tr>
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;">Role</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;">{{roleLabel}}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

{{> button url=loginUrl label="Sign in to your account" brandPrimary=brandPrimary}}

<p style="margin:0;font-size:13px;line-height:1.5;color:#6c757d;">
  For security, please change your password after your first login.
  If you did not expect this email, contact
  <a href="mailto:{{supportEmail}}" style="color:{{brandPrimary}};text-decoration:none;font-weight:600;">{{supportEmail}}</a>.
</p>
