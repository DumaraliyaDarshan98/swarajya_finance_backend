<h1 style="margin:0 0 12px;font-size:22px;font-weight:700;color:#212529;line-height:1.3;">
  Reset your password
</h1>
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#495057;">
  We received a request to reset the password for your {{brandName}} account.
  Click the button below to choose a new password.
</p>

{{> button url=resetLink label="Reset password" brandPrimary=brandPrimary}}

<p style="margin:0 0 12px;font-size:13px;line-height:1.5;color:#6c757d;">
  Or copy and paste this link into your browser:
</p>
<p style="margin:0 0 20px;font-size:12px;line-height:1.5;word-break:break-all;">
  <a href="{{resetLink}}" style="color:{{brandPrimary}};">{{resetLink}}</a>
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fff8f0;border:1px solid #ffe0c2;border-radius:8px;">
  <tr>
    <td style="padding:12px 14px;font-size:13px;color:#6c757d;line-height:1.5;">
      This link expires in <strong style="color:#212529;">15 minutes</strong>.
      If you did not request a password reset, you can safely ignore this email.
    </td>
  </tr>
</table>
