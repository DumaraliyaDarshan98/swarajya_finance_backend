<h1 style="margin:0 0 12px;font-size:22px;font-weight:700;color:#212529;line-height:1.3;">
  {{#if approved}}Field agent account approved{{else}}Your field agent login{{/if}}
</h1>
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#495057;">
  Hello <strong>{{name}}</strong>,
</p>
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#495057;">
  {{#if approved}}
  Your field agent account has been approved. Use the credentials below to sign in and start working on assigned cases.
  {{else}}
  Your field agent login has been created. Use the credentials below to access the portal.
  {{/if}}
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 20px;background-color:#f8f9fa;border:1px solid #e9ecef;border-radius:10px;">
  <tr>
    <td style="padding:16px 18px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;width:140px;">Field Agent ID</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;">{{fieldAgentId}}</td>
        </tr>
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;">Email (login)</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;">{{email}}</td>
        </tr>
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;">Password</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;font-family:Consolas,Monaco,monospace;">{{password}}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

{{> button url=loginUrl label="Sign in" brandPrimary=brandPrimary}}

<p style="margin:0;font-size:13px;line-height:1.5;color:#6c757d;">
  Please complete onboarding and mandatory training after your first login. Change your password for security.
</p>
