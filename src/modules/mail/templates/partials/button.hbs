<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
  <tr>
    <td align="left">
      <a
        class="btn"
        href="{{url}}"
        style="display:inline-block;background-color:{{brandPrimary}};color:#ffffff !important;font-size:14px;font-weight:600;text-decoration:none;padding:12px 22px;border-radius:8px;line-height:1.2;"
      >
        {{label}}
      </a>
    </td>
  </tr>
</table>
