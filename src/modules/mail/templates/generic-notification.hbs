<h1 style="margin:0 0 12px;font-size:22px;font-weight:700;color:#212529;line-height:1.3;">
  {{#if title}}{{title}}{{else}}Notification{{/if}}
</h1>

{{#if name}}
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#495057;">
  Hello <strong>{{name}}</strong>,
</p>
{{/if}}

<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#495057;white-space:pre-wrap;">{{message}}</p>

{{#if details}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 20px;background-color:#f8f9fa;border:1px solid #e9ecef;border-radius:10px;">
  <tr>
    <td style="padding:16px 18px;font-size:14px;line-height:1.6;color:#212529;white-space:pre-wrap;">{{details}}</td>
  </tr>
</table>
{{/if}}

{{#if ctaUrl}}
{{> button url=ctaUrl label=ctaLabel brandPrimary=brandPrimary}}
{{else}}
{{> button url=loginUrl label="Open portal" brandPrimary=brandPrimary}}
{{/if}}
