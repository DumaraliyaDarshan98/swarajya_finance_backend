<h1 style="margin:0 0 12px;font-size:22px;font-weight:700;color:#212529;line-height:1.3;">
  We received your application
</h1>

<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#495057;">
  Hello <strong>{{name}}</strong>,
</p>

<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#495057;">
  Thank you for applying to <strong>{{brandName}}</strong>. We have received your job application
  and resume. Our hiring team will review your profile and contact you if there is a fit.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 20px;background-color:#f8f9fa;border:1px solid #e9ecef;border-radius:10px;">
  <tr>
    <td style="padding:16px 18px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;width:140px;">Application ID</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;font-family:Consolas,Monaco,monospace;">{{applicationId}}</td>
        </tr>
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;">Email</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;">{{email}}</td>
        </tr>
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;">Mobile</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;">{{mobileNumber}}</td>
        </tr>
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;">Skill(s)</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;">{{skill}}</td>
        </tr>
        <tr>
          <td style="padding:6px 0;font-size:13px;color:#6c757d;">Resume</td>
          <td style="padding:6px 0;font-size:14px;color:#212529;font-weight:600;">{{resumeName}}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p style="margin:0 0 8px;font-size:15px;line-height:1.6;color:#495057;">
  No further action is needed from you right now. If your profile matches an open role, we will reach out using the contact details you provided.
</p>

<p style="margin:16px 0 0;font-size:13px;line-height:1.5;color:#6c757d;">
  Questions? Contact us at
  <a href="mailto:{{supportEmail}}" style="color:{{brandPrimary}};text-decoration:none;font-weight:600;">{{supportEmail}}</a>
  {{#if supportPhone}}
  or <a href="tel:{{supportPhone}}" style="color:{{brandPrimary}};text-decoration:none;font-weight:600;">{{supportPhone}}</a>
  {{/if}}.
</p>
