# Server Configuration
PORT=3200
API_PREFIX=api
NODE_ENV=development

# Database Configuration
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=swarajya_finance
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d

# Super Admin Configuration
SUPER_ADMIN_SECRET=your-super-admin-secret-key-change-this-in-production

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@swarajya.com

# Frontend URL
FRONTEND_URL=http://localhost:4200

# Telephony (Exotel Voice API)
TELEPHONY_PROVIDER=exotel
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# ExoPhone — dashes/spaces are stripped automatically (e.g. 079-485-02892 → 07948502892)
EXOTEL_CALLER_ID=
# MUST be a real public HTTPS URL Exotel can reach (NOT localhost, NOT placeholders).
# Examples:
#   https://abc123.ngrok-free.app/api
#   https://api.yourdomain.com/api
# StatusCallback becomes: {EXOTEL_WEBHOOK}/exotel/webhook
# Leave empty to dial without webhook. Enable recording inside the Exotel flow/applet.
EXOTEL_WEBHOOK=
# Singapore: api.exotel.com | Mumbai: api.in.exotel.com
EXOTEL_API_SUBDOMAIN=api.exotel.com
# Exotel flow (applet) IDs — create flows in Exotel dashboard with greeting messages
EXOTEL_FLOW_APP_ID_INITIAL_SUBMISSION=
EXOTEL_FLOW_APP_ID_AGENT_ASSIGNED=
EXOTEL_FLOW_APP_ID_FINAL_REPORT=
EXOTEL_FLOW_APP_ID_RECALL=
EXOTEL_FLOW_APP_ID_CUSTOM=